# Copy to .env for local development. Never commit the real .env.

# Local default is SQLite; Render injects the real Postgres URL.
# DATABASE_URL=postgresql://user:pass@host:5432/jobaggregator

# Required in production. Without it a random secret is generated per process,
# so sessions die on restart and break across workers.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30

# Comma-separated. Set to your Vercel URL in production.
CORS_ORIGINS=http://localhost:8000

# Optional: enables the LLM normalization fallback. Omit to run rules-only.
# ANTHROPIC_API_KEY=

# Optional: Slack/Discord webhook for scrape failure and anomaly alerts.
# ALERT_WEBHOOK_URL=
